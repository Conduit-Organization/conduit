# Conduit environment — TESTNET ONLY. Never commit a real secret or a funded mainnet key.
# Copy to .env and fill in. Both roles (buyer/seller) read this.

# --- P2P identity (Holepunch) ---
# 64-char hex seed for a deterministic Hyperswarm identity. Leave blank to use a random one per run.
CONDUIT_SEED=

# --- Wallet (WDK / EVM) ---
# Testnet wallet seed phrase (BIP-39 mnemonic). TESTNET FUNDS ONLY.
CONDUIT_WALLET_MNEMONIC=

# --- Settlement chain (disclosed NON-AI remote: a testnet RPC) ---
# Default per plan: Ethereum Sepolia. Confirmed/overridden by Spike #1.5.
CONDUIT_RPC_URL=https://rpc.sepolia.org
CONDUIT_CHAIN_ID=11155111
# Test USD₮ token contract on the chosen testnet (set after Spike #1.5 picks the chain + token).
CONDUIT_USDT_ADDRESS=

# --- Role / runtime ---
# buy | sell | bench  (defaults handled per-script)
CONDUIT_ROLE=

# --- ETHOnline 2026: global reputation (The Graph) ---
# Subgraph Studio query URL. Unset = the app falls back to local first-party reputation
# only, exactly as it behaved before. Get it from https://thegraph.com/studio -> Query.
CONDUIT_SUBGRAPH_URL=

# --- ETHOnline 2026: human verification (World AgentKit) ---
# Buyer side: 1 = obtain a World AgentKit proof and attach it to sessionOpen.
CONDUIT_HUMAN_PROOF=0
# Seller side: 1 = refuse sessions from wallets not registered to a verified human.
# Seller POLICY — off by default, so a seller sells to any funded keypair as before.
CONDUIT_REQUIRE_HUMAN=0
# Optional World Chain RPC for AgentBook lookups (defaults to the SDK's public endpoint).
CONDUIT_WORLDCHAIN_RPC=
# Seller side: refuse a buyer whose qualified abandonment rate exceeds this (0..1).
CONDUIT_MAX_BUYER_ABANDONMENT=0.5

# --- ETHOnline 2026: settlement network ---
# Named network profile from src/core/networks.ts: sepolia | arc-testnet.
# Individual vars above still override whatever the profile supplies.
CONDUIT_NETWORK=sepolia
