# Conduit environment — TESTNET ONLY. Never commit a real secret or a funded mainnet key.
# Copy to .env and fill in. Both roles (buyer/seller) read this.

# --- P2P identity (Holepunch) ---
# 64-char hex seed for a deterministic Hyperswarm identity. Leave blank to use a random one per run.
CONDUIT_SEED=

# --- Wallet (WDK / EVM) ---
# Testnet wallet seed phrase (BIP-39 mnemonic). TESTNET FUNDS ONLY.
CONDUIT_WALLET_MNEMONIC=

# --- Settlement chain (disclosed NON-AI remote: a testnet RPC) ---
# Default per plan: Ethereum Sepolia. Confirmed/overridden by Spike #1.5.
CONDUIT_RPC_URL=https://rpc.sepolia.org
CONDUIT_CHAIN_ID=11155111
# Test USD₮ token contract on the chosen testnet (set after Spike #1.5 picks the chain + token).
CONDUIT_USDT_ADDRESS=

# --- Role / runtime ---
# buy | sell | bench  (defaults handled per-script)
CONDUIT_ROLE=
